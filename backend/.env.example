# Server
PORT=5000
NODE_ENV=development

# MongoDB – local: mongodb://127.0.0.1:27017/team_management
#           cloud: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://127.0.0.1:27017/team_management

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
